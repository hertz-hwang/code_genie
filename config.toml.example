# =========================================================================
# 🔧 CodeGenie 配置文件
# =========================================================================

# 禁止出简码的字集（字符串，每个字符均不参与简码分配；空字符串或不填表示不限制）
# ⚠️  此字段必须放在任何 [section] 之前，否则 TOML 会将其归入上方的 section 而被忽略
# 示例：simple_forbidden_chars = "的了是在"
simple_forbidden_chars = ""

# -------------------------------------------------------------------------
# 📂 文件路径配置
# -------------------------------------------------------------------------
[files]
# 固定字根文件：每行格式为 "字根名\t键位"
#   - 单个键位 → 固定字根，直接绑定该键，不参与优化
#   - 多个键位（空格分隔）→ 有约束字根，优化时只能从这些键中选一个
fixed = "input-fixed.txt"

# 动态字根文件：每行为一组字根（空格分隔），同组字根共享同一键位
#   优化器会为每组选择最优键位，是优化的主要对象
dynamic = "input-roots.txt"

# 拆分表文件：每行格式为 "汉字\t字根1 字根2 ...\t频率"
#   定义每个汉字由哪些字根组成，以及该汉字在语料中的使用频率
splits = "input-division.txt"
word_div = "input-worddiv.txt"   # 多字词拆分文件（启用词码优化时需要）

# 字根对当量文件：每行格式为 "键对\t当量值"
#   记录两个键连续击打的手指移动代价（当量越小越流畅）
#   与 --keysoul 参数互斥：使用 --keysoul 时忽略此文件，改用物理模型计算
pair_equiv = "pair_equivalence.txt"

# 用指分布文件：每行格式为 "键位\t目标%\t低惩罚\t高惩罚"
#   定义每个键位的理想使用频率及偏离惩罚，用于优化键位负载均衡
key_dist = "key_distribution.txt"

# -------------------------------------------------------------------------
# ⚖️ 权重配置
# -------------------------------------------------------------------------
# 顶层权重：三组目标的相对重要性（建议总和为 1.0）
[weights]
full = 0.5       # 单字全码权重
simple = 0.3     # 单字简码权重
word = 0.2       # 多字词全码权重（需同时启用 word_code.enabled）

# 单字全码子权重（calibrate_scales 已将各指标归一化到初始值≈1.0，子权重直接表达各指标的相对重要性，无需归一化）
[weights.full_code]
top_n = 1500                  # 字频前 N 重码数的 N 值
top_n_collision_count = 1.0   # 前 N 重码数权重
collision_count = 1.0         # 总重码数权重
collision_rate = 1.0          # 重码率权重
equivalence = 1.0             # 当量权重
distribution = 1.0            # 键位分布偏差权重

# 单字简码子权重（同上，无需归一化）
[weights.simple_code]
enabled = true
weighted_key_length = 1.0     # 加权码长权重（全字符加权平均码长）
collision_count = 1.0         # 重码数权重
collision_rate = 1.0          # 重码率权重
equivalence = 1.0             # 当量权重
distribution = 1.0            # 键位分布偏差权重

# 多字词全码子权重（同上，无需归一化）
[weights.word_code]
enabled = true                  # 是否启用词码优化
top2000_collision_count = 1.0   # 词频前 2000 重码数权重
top10000_collision_count = 1.0  # 词频前 10000 重码数权重
collision_count = 1.0           # 总重码数权重
collision_rate = 1.0            # 重码率权重
equivalence = 1.0               # 当量权重
distribution = 1.0              # 键位分布偏差权重

[amhb]
total_neighbors = 240      # EXP3 算子池大小（总邻居数）
steal_threshold = 0        # 工作窃取阈值
total_steps = 1000000000     # 最大迭代步数
temp_start = 40.0          # AMHB 初始温度

# 分段降温参数（piecewise exponential cooling）
# 每段定义 threshold 和 factor：当 temp > threshold 时，每步 temp *= factor
# 按 threshold 从高到低排列，第一个满足的段生效
# 若温度低于所有阈值，优化终止
[[amhb.cooling_segments]]
threshold = 7.5            # 高温区
factor = 0.99999

[[amhb.cooling_segments]]
threshold = 1.75           # 中高温区
factor = 0.999999

[[amhb.cooling_segments]]
threshold = 1.25           # 中低温区
factor = 0.9999995

[[amhb.cooling_segments]]
threshold = 0.15           # 低温区
factor = 0.9999999625

# -------------------------------------------------------------------------
# 🌡️ 模拟退火参数
# -------------------------------------------------------------------------
[annealing]
threads = 12             # 并行线程数
total_steps = 2000000     # 单线程迭代步数
temp_start = 100.0         # 初始温度 (0=自动校准，推荐)
temp_end = 0.000001      # 结束温度
comfort_temp = 0.4       # 舒适温度区间
comfort_width = 0.15     # 舒适区宽度
comfort_slowdown = 0.7   # 舒适区减速因子
swap_probability = 0.35   # 交换操作概率

# 以下参数基于 total_steps 的比例计算
min_improve_steps_ratio = 0.1    # 最小改进步数比例 (total_steps / 10)
perturb_interval_ratio = 0.0    # 设为 0 可关闭低温扰动
perturb_strength = 0.0          # 扰动强度
perturb_trigger_temp_ratio = 0.01 # 扰动触发温度比例 (base_temp < comfort_temp * ratio)
perturb_temp_multiplier = 2.0     # 扰动时温度倍率 (temp * multiplier)
perturb_collision_pairs_limit = 10 # 扰动时优先采样的冲突对上限
reheat_factor = 1.0             # 设为 1.0 可关闭重新加热
max_parts = 3                    # 最大码长

# -------------------------------------------------------------------------
# ⌨️ 键位配置
# -------------------------------------------------------------------------
[keys]
# 允许的键位字符（用于动态字根分配）
allowed = "qwertyuiopasdfghjklzxcvbnm"
# 键位显示顺序（用于输出报告）
display_order = "qwertyuiopasdfghjklzxcvbnm"

# -------------------------------------------------------------------------
# 📝 简码规则配置
# -------------------------------------------------------------------------
# 取码规则说明:
#   每两个字符为一组，第一个字符选择逻辑根，第二个字符选择该根的码位
#   根选择: A=第1根, B=第2根, C=第3根, ... Z=最后一根
#   码位选择: a=第1码, b=第2码, c=第3码, ... z=最后一码
#
# 示例: 拆分 "在 𠂇 𠂇.1 2 土 土.1"
#   逻辑根: [𠂇(码=[𠂇,𠂇.1]), 2(码=[2]), 土(码=[土,土.1])]
#   Aa = 𠂇的第1码, Ab = 𠂇的第2码
#   Ba = 2的第1码
#   Ca = 土的第1码, Cz = 土的最后一码
#   Za = 最后一根(土)的第1码, Zz = 最后一根(土)的最后一码

# 一级简码：只用 1 个键表示一个汉字（最短简码）
#   level=1 表示一级简码
#   code_num=0 表示不限制数量，按频率贪心分配（尽量多分配）
#     若设为正整数 N，则只分配频率最高的 N 个汉字
#   rules=["Aa"] 表示取第1逻辑根的第1个码位作为简码
[[simple_levels]]
level = 1                # 简码级数
code_num = 1             # 简码个数
rules = ["Aa"]           # 简码规则
allowed_orig_length = 0  # 0 = 不限制；设为正整数则只允许该码长的全码出简码
yield_full_code = true   # 出简让全：true = 已出简的字让出其全码码位，允许其他字出简到该位置

# 二级简码：用 2 个键表示一个汉字
#   rules=["AaBa"] 表示取第1根第1码 + 第2根第1码
[[simple_levels]]
level = 2
code_num = 1
rules = ["AaBa"]
allowed_orig_length = 0
yield_full_code = true

# 三级简码：用 3 个键表示一个汉字
#   rules 支持多个候选规则，系统依次尝试，选择第一个能成功解析的规则
#   "AaBaCa" = 第1根第1码 + 第2根第1码 + 第3根第1码
[[simple_levels]]
level = 3
code_num = 1
rules = ["AaBaCa"]
allowed_orig_length = 0
yield_full_code = true
